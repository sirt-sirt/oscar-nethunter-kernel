# ==============================================================================
# Kali NetHunter config fragment - Realme 9 Pro 5G (oscar / SM6375 "holi")
#
# Merge AFTER arch/arm64/configs/vendor/holi-qgki_defconfig:
#   scripts/kconfig/merge_config.sh -m -O out out/.config \
#       arch/arm64/configs/vendor/nethunter_oscar.config
#   make O=out olddefconfig
#
# This file is UTF-8. The NetHunter block appended directly to
# holi-qgki_defconfig was saved as cp1251 and its Russian comments are now
# unreadable mojibake - do not copy that pattern.
# ==============================================================================

# ------------------------------------------------------------------------------
# SysVIPC - MANDATORY for the Kali chroot.
# Commit 6691df9 deleted these "to fix ABI bootloop". That was a misdiagnosis:
# the bootloop came from the force-accept hack in kernel/module.c, which has
# nothing to do with SysV IPC. Metasploit's PostgreSQL will not start without it.
# ------------------------------------------------------------------------------
# ------------------------------------------------------------------------------
# Kernel release string - MANDATORY, and the easiest thing here to get wrong.
#
# The phone's stock modules carry:
#   vermagic=5.4.280-qgki-ge408f03a5c42 SMP preempt mod_unload modversions aarch64
#
# CORRECTION (build 10): the .scmversion mechanism described below WAS
# abandoned and this comment is kept only as a record of how the wrong turn
# looked. Run 32503060142 proved that scripts/setlocalversion never reads
# .config - it sources include/config/auto.conf, a mirror written by
# syncconfig, which was stale. The hash now travels in the LOCALVERSION
# environment variable set by the CI workflow, and the workflow overrides
# CONFIG_LOCALVERSION_AUTO back to "is not set" through /tmp/release.config.
# So the CONFIG_LOCALVERSION_AUTO=y line below is deliberately overridden at
# merge time and merge_config.sh prints a "redefined by fragment" notice for
# it. That notice is expected.
#
# ---- historical reasoning, no longer the mechanism in use ----
# We reproduce "5.4.280-qgki-ge408f03a5c42" with CONFIG_LOCALVERSION="-qgki"
# plus a .scmversion file holding "-ge408f03a5c42". But scripts/setlocalversion
# only consults .scmversion from inside scm_version(), and scm_version() is
# only called on the CONFIG_LOCALVERSION_AUTO=y branch:
#
#   if test "$CONFIG_LOCALVERSION_AUTO" = "y"; then
#           res="$res$(scm_version)"
#   else
#           # only appends a "+" when the tree is not a clean tagged state
#   fi
#
# HEAD carries "# CONFIG_LOCALVERSION_AUTO is not set", so .scmversion would be
# IGNORED, the release would be plain "5.4.280-qgki", vermagic would not match
# and every stock vendor module would be refused. The live config extracted
# from the v9 build has CONFIG_LOCALVERSION_AUTO=y - that is exactly why v9
# came out as "5.4.280-qgki-gcbf5933ff648-dirty": git hash plus dirty flag,
# because v9 had no .scmversion. With .scmversion present, scm_version()
# returns its contents verbatim and no "-dirty" is appended.
# ------------------------------------------------------------------------------
CONFIG_LOCALVERSION="-qgki"
CONFIG_LOCALVERSION_AUTO=y

CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y

# ------------------------------------------------------------------------------
# Namespaces - MANDATORY for chroot / proot. PID_NS was deleted by the same
# commit and a NetHunter chroot cannot work without it.
# ------------------------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y

# ------------------------------------------------------------------------------
# Module ABI. THIS BLOCK IS THE WHOLE BALLGAME - read it before changing it.
#
# The device loads 39 vendor modules from /vendor/lib/modules at boot
# (camera.ko, ~30 audio *_dlkm.ko, btpower.ko, bt_fm_slim.ko, rmnet_*.ko).
# Change the kernel and every one of them is at risk.
#
# CORRECTION (build 10) - the reasoning below about same_magic() is CORRECT but
# it was load-bearing for a plan that no longer exists. It is true that with
# MODVERSIONS=y the kernel skips the release half of vermagic for a module that
# carries CRCs. What that paragraph then concluded - that stock modules
# therefore "have a chance of loading" - is wrong in practice, and this is the
# single most expensive mistake in this project:
#
#   CONFIG_SYSVIPC and CONFIG_USER_NS both add members to task_struct:
#       #ifdef CONFIG_SYSVIPC
#               struct sysv_sem sysvsem;
#               struct sysv_shm sysvshm;
#       #endif
#   genksyms hashes a symbol's full expanded type graph, so every exported
#   symbol whose signature reaches task_struct, cred or nsproxy gets a
#   DIFFERENT CRC. vermagic matches byte for byte and the module is still
#   refused, with "disagrees about version of symbol". Skipping the release
#   string only moves the check onto the CRCs, and the CRCs are exactly what
#   the chroot options change.
#
# So MODVERSIONS=y stays - it is part of the vermagic string the device
# expects - but nothing is "left stock" any more. All 39 modules are rebuilt
# from this tree and shipped inside a rebuilt vendor_dlkm.img. See
# nethunter/build-vendor-dlkm.sh. The upside is that ABI drift no longer
# matters at all: our kernel and our modules are one unit.
#
# Checked in arch/Kconfig: LTO_CLANG depends only on ARCH_SUPPORTS_LTO_CLANG,
# !KASAN, !FTRACE_MCOUNT_RECORD||HAVE_C_RECORDMCOUNT and CC_IS_CLANG/LD_IS_LLD.
# There is NO "depends on !MODVERSIONS", so MODVERSIONS + LTO + CFI coexist.
#
# LTO_CLANG and CFI_CLANG stay ON, and they must match the stock config, which
# also has both on. A CFI kernel and non-CFI modules (or the reverse) fail with
# "Unknown symbol __cfi_slowpath". That is what killed Wi-Fi and Bluetooth in
# v9, where commit cbf5933 turned LTO and CFI off.
# ------------------------------------------------------------------------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y
CONFIG_MODVERSIONS=y
# CONFIG_LTO_NONE is not set
CONFIG_LTO_CLANG=y
CONFIG_CFI_CLANG=y

CONFIG_MODULE_FORCE_LOAD=y

# ------------------------------------------------------------------------------
# FOUR SYMBOLS THAT MUST STAY OFF. Each one silently refuses stock modules.
# All four were verified OFF in the live .config extracted from the v9 Image;
# they are pinned here so this no longer depends on the base defconfig.
#
#   MODULE_SIG / MODULE_SIG_FORCE
#       Would demand a signature the stock vendor modules do not carry. This
#       is the "the modules would not load because of signatures" theory - it
#       was never enabled, so it was never the cause, and the rejection
#       message it produces ("Loading of unsigned module is rejected") could
#       not have appeared. Pinned so it can never become the cause.
#
#   TRIM_UNUSED_KSYMS
#       Would drop every exported symbol no in-tree module happens to use.
#       The stock modules would then fail with "Unknown symbol" - which looks
#       exactly like a signature or ABI problem but is not.
#
#   MODULE_COMPRESS
#       Would emit .ko.gz, which neither the stock module load path nor our
#       own packaging step expects.
#
# MODULE_FORCE_LOAD above is the opposite of the eddbb4a hack. That commit
# patched check_version() and same_magic() to return 1 unconditionally, so
# EVERY module was accepted silently and mismatched ones then corrupted memory
# - the bootloop. MODULE_FORCE_LOAD changes no default behaviour at all; it
# only makes "insmod -f" available as a deliberate, per-module escape hatch,
# which is the safe way to test whether a refused module is genuinely
# incompatible.
# ------------------------------------------------------------------------------
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_TRIM_UNUSED_KSYMS is not set
# CONFIG_MODULE_COMPRESS is not set

# ------------------------------------------------------------------------------
# EROFS - not optional, and not obvious.
#
# /vendor_dlkm is an erofs filesystem and we now build and flash that image
# ourselves, so the kernel that mounts it has to be able to read everything we
# put in it:
#
#   EROFS_FS_XATTR / EROFS_FS_SECURITY
#       The SELinux labels inside the image are extended attributes. Without
#       these two the mount succeeds and every file comes back unlabelled,
#       init cannot read the modules, and the phone boots with no camera, no
#       audio, no Wi-Fi and no Bluetooth - the same symptom as an ABI failure,
#       reached by a completely different route. This is the one that would
#       have cost another two days to diagnose.
#
#   EROFS_FS_ZIP
#       mkfs.erofs compresses with LZ4 by default and 41 of the 51 stock
#       inodes are compressed. Without ZIP support those files are unreadable.
#
# All four default to y in fs/erofs/Kconfig and are y in the stock config, so
# these lines change nothing today. They are pinned so that a future defconfig
# edit cannot turn the phone into a brick without tripping the CI gate.
# ------------------------------------------------------------------------------
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y

# ------------------------------------------------------------------------------
# Camera is a LOADABLE MODULE on this platform, not built-in.
# techpack/camera/config/holicamera.conf sets CONFIG_SPECTRA_CAMERA=m and
# techpack/camera/drivers/Makefile ends with
#     obj-$(CONFIG_SPECTRA_CAMERA) += camera.o
#     BOARD_VENDOR_KERNEL_MODULES += $(KERNEL_MODULES_OUT)/camera.ko
# so the camera lives in camera.ko and dies with any kernel change unless that
# module is rebuilt and shipped. CONFIG_SPECTRA_CAMERA is a Makefile-level
# export gated on CONFIG_ARCH_HOLI, NOT a Kconfig symbol - it cannot be set
# here, and it must not be "fixed" by adding it to this file.
# ------------------------------------------------------------------------------
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MSM_CVP=y
CONFIG_MSM_GLOBAL_SYNX=y

# ------------------------------------------------------------------------------
# Audio is ENTIRELY modular: every single line of
# techpack/audio/config/holiauto.conf is "=m" (~40 modules). Their names are
# defined in techpack/audio/*/Kbuild with the _dlkm suffix, e.g.
#     obj-$(CONFIG_SND_SOC_MSM_QDSP6V2_INTF) += q6_dlkm.o
#     obj-$(CONFIG_MSM_ADSP_LOADER)          += adsp_loader_dlkm.o
#     obj-$(CONFIG_MSM_QDSP6_PDR)            += q6_pdr_dlkm.o
#     obj-$(CONFIG_MSM_QDSP6_NOTIFIER)       += q6_notifier_dlkm.o
# which matches /vendor/lib/modules exactly. Nothing to set here - just do not
# forget to package them, or the phone boots silently with no sound.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Internal Wi-Fi. The device ships qca_cld3_wlan.ko, while an in-tree build of
# drivers/staging/qcacld-3.0 produces wlan.ko, because its Kbuild does:
#     ifeq ($(MODNAME),)   -> KERNEL_BUILD := y -> MODNAME := wlan
#     obj-$(CONFIG_QCA_CLD_WLAN) += $(MODNAME).o
# and further down:
#     ifneq ($(MODNAME), wlan)
#     CHIP_NAME ?= $(MODNAME)
#     ccflags-y += -DMULTI_IF_NAME=\"$(CHIP_NAME)\"
#     endif
#
# A PLAIN RENAME of wlan.ko to qca_cld3_wlan.ko is the correct packaging step.
# This CORRECTS an earlier conclusion that called for an external build with
# MODNAME=qca_cld3_wlan - that would have BROKEN Wi-Fi. The evidence:
#
#   * lsmod on the stock ROM reports the loaded module as "wlan", not
#     "qca_cld3_wlan". modpost bakes KBUILD_MODNAME into the
#     .gnu.linkonce.this_module section and a filename cannot change it, so
#     the stock file was compiled as wlan.o too.
#   * Passing MODNAME=qca_cld3_wlan takes the ifneq branch above and DEFINES
#     MULTI_IF_NAME, which changes the firmware/ini search path.
#   * /vendor/firmware/wlan/ holds exactly one subdirectory, qca_cld, which is
#     the path used when MULTI_IF_NAME is left undefined.
#
# So the stock module was built with MULTI_IF_NAME undefined, and an in-tree
# build reproduces that by construction - both resolve the same firmware path,
# so the exact default never has to be hardcoded. An external build would have
# sent the driver looking for a directory that does not exist.
#
# Note also that qca_cld3_wlan is BLOCKLISTED in the stock modules.blocklist,
# with the comment "the module will be loaded from the target RC after cold
# boot calibration". Our rebuilt vendor_dlkm.img reproduces that blocklist
# verbatim. Removing it would make init load the driver before calibration.
# ------------------------------------------------------------------------------
CONFIG_QCA_CLD_WLAN=m
CONFIG_CLD_LL_CORE=y
CONFIG_CNSS_GENL=y
CONFIG_WCNSS_MEM_PRE_ALLOC=y
CONFIG_ICNSS2=y
CONFIG_ICNSS2_QMI=y

# ------------------------------------------------------------------------------
# Bluetooth. drivers/bluetooth/Makefile:
#     obj-$(CONFIG_MSM_BT_POWER) += btpower.o
#     bt_fm_slim-objs := btfm_slim.o btfm_slim_codec.o btfm_slim_slave.o
#     obj-$(CONFIG_BTFM_SLIM)    += bt_fm_slim.o
# so the modules are btpower.ko and bt_fm_slim.ko - note the underscores,
# it is NOT btfm_slim.ko. Both names confirmed against /vendor/lib/modules.
# ------------------------------------------------------------------------------
CONFIG_MSM_BT_POWER=m
CONFIG_BTFM_SLIM=m
CONFIG_SLIMBUS=y
CONFIG_SLIMBUS_MSM_NGD=y

CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_HCIBTUSB=y
CONFIG_RFKILL=y

# ------------------------------------------------------------------------------
# Mobile data. rmnet_core.ko / rmnet_ctl.ko / rmnet_offload.ko / rmnet_shs.ko
#
# CORRECTION: an earlier version of this comment said these four could not be
# rebuilt from this repository and would have to stay stock. That was wrong.
# They come from techpack/datarmnet/core and
# techpack/datarmnet-ext/{offload,shs}, all behind an unconditional obj-m, and
# build 9 produced all four. The in-tree
# drivers/net/ethernet/qualcomm/rmnet/Makefile does indeed only produce a
# single rmnet.ko - that is a different, competing driver, which is why
# CONFIG_RMNET is deliberately left alone.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# CONFIG_STAGING is what makes the Wi-Fi driver exist at all.
#
# drivers/staging/Kconfig declares CONFIG_QCA_CLD_WLAN (and R8188EU) inside an
# "if STAGING" block. If STAGING were ever off, olddefconfig would drop the
# Wi-Fi driver without printing a single warning, the build would still
# succeed, the zip would still flash, and the only symptom would be a Wi-Fi
# toggle that never turns on. Pinned here so this fragment does not silently
# depend on the vendor defconfig keeping it enabled.
#
# The profile string resolves to drivers/staging/qcacld-3.0/configs/
# default_defconfig, which is the in-tree default and what the stock module
# was built with.
# ------------------------------------------------------------------------------
CONFIG_STAGING=y
CONFIG_QCA_CLD_WLAN_PROFILE="default"

# ------------------------------------------------------------------------------
# Wireless stack: monitor mode and injection need WEXT plus a regulatory domain
# that actually honours "iw reg set" and full TX power.
#
# CERTIFICATION_ONUS is the reason the two negations below had no effect until
# now. net/wireless/Kconfig declares them as
#     bool "require regdb signature" if CFG80211_CERTIFICATION_ONUS
#     default y
# A symbol whose prompt is conditional and whose condition is false is not
# user-settable, so Kconfig ignores the "is not set" lines and silently keeps
# the default y. Stock has CERTIFICATION_ONUS=n and both regdb options y.
# Turning ONUS on is what makes the two lines below take effect and lets the
# card leave the regulatory box the vendor firmware puts it in.
# ------------------------------------------------------------------------------
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_WIRELESS_EXT=y
CONFIG_WEXT_PRIV=y
CONFIG_CFG80211_CERTIFICATION_ONUS=y
# CONFIG_CFG80211_REQUIRE_SIGNED_REGDB is not set
# CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS is not set

# ------------------------------------------------------------------------------
# External dongle: TP-Link TL-WN722N v2 (sticker: IC 8853A-WN722NV2)
# -> Realtek RTL8188EUS. Only v1 is Atheros AR9271.
#
# R8188EU and RTL8XXXU were BOTH enabled and they fight over the same USB ID,
# and neither does real monitor mode or packet injection. Both are disabled
# here; CI builds the aircrack-ng rtl8188eus driver (8188eu.ko) out-of-tree.
#
# The resulting 8188eu.ko is NOT in vendor_dlkm.img. It does not fit - the
# partition is 10731520 bytes and the 39 device modules leave about 250 KB - and
# it must not load at boot anyway. It ships at the root of the zip and is
# copied to /data/adb/nh/8188eu.ko for a manual insmod.
# ------------------------------------------------------------------------------
CONFIG_WLAN_VENDOR_REALTEK=y
# CONFIG_R8188EU is not set
# CONFIG_RTL8XXXU is not set
CONFIG_LIB80211=m
CONFIG_LIB80211_CRYPT_WEP=m
CONFIG_LIB80211_CRYPT_CCMP=m
CONFIG_LIB80211_CRYPT_TKIP=m

# ------------------------------------------------------------------------------
# USB OTG hacking hardware: Proxmark3, HackRF, CH341/CP210x/FTDI/PL2303.
#
# USB_ANNOUNCE_NEW_DEVICES makes the kernel print vendor/product/serial for
# every device that attaches. Stock has it off. With a pile of OTG adapters to
# bring up it turns "nothing happened" into a readable dmesg line, which is
# worth the handful of bytes.
# ------------------------------------------------------------------------------
CONFIG_USB_OTG=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_ACM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_OPTION=y

# ------------------------------------------------------------------------------
# BadUSB / HID attacks and USB tethering from the NetHunter app.
# ------------------------------------------------------------------------------
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y

# ------------------------------------------------------------------------------
# SDR stays (RTL-SDR / HackRF). Digital and analog TV go away.
#
# CORRECTION: the three negations below do NOT remove the tuner drivers, and
# the claim that they did was wrong. Build 9 shipped 75 modules: 39 for the
# device, 1 dongle, and 35 DVB tuners that came in anyway. The switch that
# actually pulls them is MEDIA_SUBDRV_AUTOSELECT, which is y in this tree and
# n in the stock config - it auto-selects every I2C tuner and demodulator a
# media driver could conceivably want. Turning it off matches stock, drops all
# 35, and takes several minutes off each build.
# ------------------------------------------------------------------------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SDR_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
# CONFIG_MEDIA_DIGITAL_TV_SUPPORT is not set
# CONFIG_MEDIA_ANALOG_TV_SUPPORT is not set
# CONFIG_DVB_CORE is not set

# ------------------------------------------------------------------------------
# Chroot storage and networking.
# ------------------------------------------------------------------------------
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_RTL8152=y

# ------------------------------------------------------------------------------
# Debug ballast the stock config does without. PAGE_OWNER keeps a stack trace
# for every page allocation; it is y here and n on stock. It costs RAM on a
# phone that has to fit a 10731520-byte vendor_dlkm image, and it buys nothing
# this project needs.
# ------------------------------------------------------------------------------
# CONFIG_PAGE_OWNER is not set
